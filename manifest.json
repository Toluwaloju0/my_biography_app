{
  "schema": 2,
  "required_executas": [
    {
      "tool_id": "tool-dev-bio-app"
    }
  ],
  "host_capabilities": ["llm.audio.speak"],
  "tags": ["biography", "journal", "memories"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Bio Archive",
        "default": true,
        "default_size": { "w": 760, "h": 900 },
        "min_size": { "w": 360, "h": 520 }
      }
    ],
    "host_api": {
      "tools": ["tool-dev-bio-app"],
      "audio": ["transcribe"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
